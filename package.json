{
  "name": "unstructured-to-structured",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fully automated, 100% in-browser unstructured → structured data converter (Vite + React + TS + Tailwind)",
  "license": "MIT",
  "author": "HarshPatil0804",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshPatil0804/RowData-Converter.git"
  },
  "homepage": "https://row-data-converter.vercel.app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "node scripts/generate-hostile.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "samples": "node scripts/generate-samples.mjs",
    "hostile": "node scripts/generate-hostile.mjs",
    "prepare:assets": "node scripts/copy-ocr-assets.mjs && node scripts/fetch-ocr-data.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "deps:record": "node scripts/deps-report.mjs --record",
    "deps:check": "node scripts/deps-report.mjs --check",
    "scan:dist": "node scripts/scan-dist.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify-live": "node scripts/verify-live.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/check-licenses.mjs && node scripts/licenses.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-table": "^8.21.3",
    "fast-xml-parser": "^5.12.0",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "wasm-feature-detect": "^1.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
